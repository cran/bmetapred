Package: bmetapred
Title: Bayesian Meta-Prediction in the Presence of Prediction Error
Version: 0.1.0
Authors@R: c(
    person("Jorge", "Piqueras Marqués", , "jorge.piqueras.m@gmail.com", role = c("aut", "cre"),
           comment = c(ORCID = "0000-0002-6812-2106")),
    person("Anabel", "Forte Deltell", , "anabel.forte@uv.es", role = "aut",
           comment = c(ORCID = "0000-0001-9534-1817")),
